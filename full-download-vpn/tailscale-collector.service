# Tailscale device list for the Homarr "Tailscale" custom widget.
# Install:
#   install -m 755 tailscale-collector.py /usr/local/bin/tailscale-collector.py
#   install -m 644 tailscale-collector.service /etc/systemd/system/tailscale-collector.service
#   systemctl daemon-reload && systemctl enable --now tailscale-collector
[Unit]
Description=Tailscale device collector for Homarr
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Environment=TS_COLLECTOR_BIND=192.168.0.17
Environment=TS_COLLECTOR_PORT=18082
Environment=TS_COLLECTOR_TOKEN_FILE=/root/.tailscale-collector-token
ExecStart=/usr/bin/python3 /usr/local/bin/tailscale-collector.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=multi-user.target
